@inherits LayoutComponentBase

<div class="app-shell">
    <NavMenu />

    <main class="main-area">
        <section class="content-shell">
            <article class="page-content">
                @Body
            </article>
        </section>
    </main>

    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-column footer-about">
                <span class="footer-eyebrow">Portefólio Profissional</span>
                <h3 class="footer-brand">Rodrigo Narciso</h3>
                <p class="footer-description">
                    Desenvolvedor de Software especializado em .NET, com foco na
                    construção de soluções robustas, modernas e escaláveis.
                </p>

                <div class="footer-status">
                    <i class="bi bi-stars"></i>
                    <span>Disponível para oportunidades profissionais</span>
                </div>
            </div>

            <div class="footer-column">
                <h4 class="footer-title">Navegação</h4>
                <ul class="footer-nav">
                    <li><NavLink href="">Início</NavLink></li>
                    <li><NavLink href="sobre">Sobre mim</NavLink></li>
                    <li><NavLink href="projetos">Projetos</NavLink></li>
                    <li><NavLink href="formacao">Formação</NavLink></li>
                    <li><NavLink href="certificacoes">Certificações</NavLink></li>
                    <li><NavLink href="contacto">Contacto</NavLink></li>
                </ul>
            </div>

            <div class="footer-column">
                <h4 class="footer-title">Contactos</h4>
                <div class="social-links">
                    <a href="https://github.com/Rnarciso15" target="_blank" class="social-link">
                        <i class="bi bi-github"></i>
                        <div>
                            <strong>GitHub</strong>
                            <span>Projetos e repositórios</span>
                        </div>
                    </a>

                    <a href="https://www.linkedin.com/in/rodrigo-narciso-21886a304" target="_blank" class="social-link">
                        <i class="bi bi-linkedin"></i>
                        <div>
                            <strong>LinkedIn</strong>
                            <span>Perfil profissional</span>
                        </div>
                    </a>

                    <a href="mailto:rodrigoalexandrenarciso@gmail.com" class="social-link">
                        <i class="bi bi-envelope-at-fill"></i>
                        <div>
                            <strong>Email</strong>
                            <span>Contacto direto</span>
                        </div>
                    </a>

                    <a href="https://wa.me/351965712134" target="_blank" class="social-link">
                        <i class="bi bi-whatsapp"></i>
                        <div>
                            <strong>WhatsApp</strong>
                            <span>Mensagem rápida</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© @DateTime.Now.Year Rodrigo Narciso. Todos os direitos reservados.</p>
        </div>
    </footer>
</div>

<a href="https://wa.me/351965712134"
   target="_blank"
   class="whatsapp-float"
   aria-label="Contactar via WhatsApp">
    <i class="bi bi-whatsapp"></i>
</a>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>