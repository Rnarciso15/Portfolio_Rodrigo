        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .title-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #4F46E5, #7C3AED, #EC4899);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
    }

    .title-icon i {
        font-size: 1.75rem;
        color: white;
    }

    .page-subtitle {
        font-size: 1.125rem;
        color: var(--text-secondary);
        max-width: 800px;
        margin: 0 auto;
        line-height: 1.7;
    }

    .certifications-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
    }

    .cert-card {
        background: rgba(11, 14, 20, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 20px;
        padding: 2.5rem 2rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        animation: fadeInUp 0.6s ease-out backwards;
    }

    .cert-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #4F46E5, #7C3AED, #EC4899);
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 0.4s ease;
    }

    .cert-card:hover::before {
        transform: scaleY(1);
    }

    .cert-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 20px 60px rgba(99, 102, 241, 0.4);
        border-color: rgba(99, 102, 241, 0.6);
        background: rgba(15, 20, 30, 0.95);
    }

    .cert-provider-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease;
    }

    .cert-card:hover .cert-provider-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .cert-provider-icon.microsoft {
        background: linear-gradient(135deg, #00A4EF, #0078D4);
    }

    .cert-provider-icon.udemy {
        background: linear-gradient(135deg, #A435F0, #8710D8);
    }

    .udemy-icon {
        width: 40px;
        height: 40px;
        object-fit: contain;
    }

    .cert-provider-icon i {
        font-size: 1.75rem;
        color: white;
    }

    .cert-card h4 {
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        margin: 0;
        line-height: 1.4;
        transition: all 0.3s ease;
    }

    .cert-card:hover h4 {
        background: linear-gradient(135deg, #4F46E5, #EC4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .cert-card p {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 0;
        font-weight: 600;
    }

    .cert-card span {
        color: var(--accent-primary);
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: auto;
        transition: all 0.3s ease;
    }

    .cert-card span::after {
        content: '→';
        font-size: 1.25rem;
        transition: transform 0.3s ease;
    }

    .cert-card:hover span {
        color: var(--accent-tertiary);
    }

    .cert-card:hover span::after {
        transform: translateX(5px);
    }

    /* Stagger animation */
    .cert-card:nth-child(1) { animation-delay: 0.05s; }
    .cert-card:nth-child(2) { animation-delay: 0.1s; }
    .cert-card:nth-child(3) { animation-delay: 0.15s; }
    .cert-card:nth-child(4) { animation-delay: 0.2s; }
    .cert-card:nth-child(5) { animation-delay: 0.25s; }
    .cert-card:nth-child(6) { animation-delay: 0.3s; }
    .cert-card:nth-child(7) { animation-delay: 0.35s; }
    .cert-card:nth-child(8) { animation-delay: 0.4s; }
    .cert-card:nth-child(9) { animation-delay: 0.45s; }
    .cert-card:nth-child(10) { animation-delay: 0.5s; }
    .cert-card:nth-child(11) { animation-delay: 0.55s; }
    .cert-card:nth-child(12) { animation-delay: 0.6s; }
    .cert-card:nth-child(13) { animation-delay: 0.65s; }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .page-title {
