@page "/"

<div class="home-container">
    <section class="hero-section">
        <div class="hero-content">
            <div class="hero-profile-section">
                <div class="hero-image-wrapper">
                    <img src="Images/Foto_perfil.jpeg" alt="Rodrigo Narciso" class="hero-profile-image" />
                    <div class="hero-profile-ring"></div>
                    <div class="hero-profile-glow"></div>
                </div>
            </div>
            <h1 class="hero-title">Rodrigo Narciso</h1>
            <h2 class="hero-subtitle">Desenvolvedor de Software (.NET)</h2>
            <p class="hero-description">
                Desenvolvedor focado em tecnologias Microsoft, com experiência prática em
                .NET, SQL e arquitectura de aplicações, orientado para soluções robustas,
                escaláveis e bem documentadas.
            </p>
        </div>
    </section>

    <!-- Quick Stats -->
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                <h3 class="stat-number">13+</h3>
                <p class="stat-label">Certificações</p>
            </div>
            <div class="stat-item">
                <div class="stat-icon">
                    <i class="bi bi-kanban-fill"></i>
                </div>
                <h3 class="stat-number">1+</h3>
                <p class="stat-label">Projetos em Produção</p>
            </div>
            <div class="stat-item">
                <div class="stat-icon">
                    <i class="bi bi-code-slash"></i>
                </div>
                <h3 class="stat-number">100%</h3>
                <p class="stat-label">Dedicação</p>
            </div>
            <div class="stat-item">
                <div class="stat-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <h3 class="stat-number">.NET</h3>
                <p class="stat-label">Especialização</p>
            </div>
        </div>
    </section>

    <!-- Featured Skills Preview -->
    <section class="skills-preview-section">
        <h2 class="section-title">Tecnologias & Competências</h2>
        <p class="section-description">Stack tecnológico focado em desenvolvimento Microsoft e arquitetura moderna</p>
        
        <div class="skills-showcase">
            <div class="skill-group">
                <div class="skill-group-header">
                    <i class="bi bi-code-square"></i>
                    <h3>Backend</h3>
                </div>
                <div class="skill-tags">
                    <span class="skill-badge primary">C# / .NET</span>
                    <span class="skill-badge primary">ASP.NET Core</span>
                    <span class="skill-badge primary">Entity Framework</span>
                    <span class="skill-badge primary">Web APIs</span>
                </div>
            </div>

            <div class="skill-group">
                <div class="skill-group-header">
                    <i class="bi bi-palette-fill"></i>
                    <h3>Frontend</h3>
                </div>
                <div class="skill-tags">
                    <span class="skill-badge secondary">Blazor WebAssembly</span>
                    <span class="skill-badge secondary">HTML/CSS</span>
                    <span class="skill-badge secondary">JavaScript</span>
                    <span class="skill-badge secondary">Bootstrap</span>
                </div>
            </div>

            <div class="skill-group">
                <div class="skill-group-header">
                    <i class="bi bi-database-fill"></i>
                    <h3>Database & Tools</h3>
                </div>
                <div class="skill-tags">
                    <span class="skill-badge tertiary">SQL Server</span>
                    <span class="skill-badge tertiary">Git/GitHub</span>
                    <span class="skill-badge tertiary">Visual Studio</span>
                    <span class="skill-badge tertiary">Azure DevOps</span>
                </div>
            </div>

            <div class="skill-group">
                <div class="skill-group-header">
                    <i class="bi bi-diagram-3-fill"></i>
                    <h3>Architecture</h3>
                </div>
                <div class="skill-tags">
                    <span class="skill-badge accent">Clean Architecture</span>
                    <span class="skill-badge accent">Microservices</span>
                    <span class="skill-badge accent">Event-Driven</span>
                    <span class="skill-badge accent">Unit Testing</span>
                </div>
            </div>
        </div>

        <div class="cta-button-container">
            <NavLink href="sobre" class="cta-button">
                <span>Ver Todas as Competências</span>
                <i class="bi bi-arrow-right"></i>
            </NavLink>
        </div>
    </section>

    <!-- Featured Project -->
    <section class="featured-project-section">
        <h2 class="section-title">Projeto em Destaque</h2>
        <p class="section-description">Soluções desenvolvidas com foco em qualidade e inovação</p>
        
        <div class="featured-project-card">
            <div class="project-badge-featured">Em Produção</div>
            <div class="project-content">
                <div class="project-header-featured">
                    <div class="project-icon-large">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h3 class="project-title-large">TradeGuard</h3>
                        <p class="project-subtitle">Plataforma de Vendas Seguras</p>
                    </div>
                </div>
                
                <p class="project-description-featured">
                    Plataforma web para venda segura de produtos usados, com sistema de
                    pagamentos condicionados, comunicação em tempo real e validação por
                    moderador. Desenvolvimento full-stack com ASP.NET MVC e arquitetura moderna.
                </p>
                
                <div class="project-highlights">
                    <div class="highlight-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Sistema de pagamentos seguros</span>
                    </div>
                    <div class="highlight-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Chat em tempo real (SignalR)</span>
                    </div>
                    <div class="highlight-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Moderação de transações</span>
                    </div>
                    <div class="highlight-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Arquitetura escalável</span>
                    </div>
                </div>
                
                <div class="project-tech-stack">
                    <span class="tech-tag">ASP.NET MVC</span>
                    <span class="tech-tag">C#</span>
                    <span class="tech-tag">SQL Server</span>
                    <span class="tech-tag">SignalR</span>
                    <span class="tech-tag">Entity Framework</span>
                    <span class="tech-tag">JavaScript</span>
                </div>
                
                <div class="project-actions">
                    <a href="https://tradeguard.runasp.net/" target="_blank" class="project-button primary">
                        <i class="bi bi-box-arrow-up-right"></i>
                        <span>Visitar Projeto</span>
                    </a>
                    <NavLink href="projetos" class="project-button secondary">
                        <span>Ver Mais Projetos</span>
                        <i class="bi bi-arrow-right"></i>
                    </NavLink>
                </div>
            </div>
        </div>
    </section>

    <!-- Recent Certifications -->
    <section class="recent-certs-section">
        <h2 class="section-title">Certificações Recentes</h2>
        <p class="section-description">Formação contínua e especialização técnica</p>
        
        <div class="recent-certs-grid">
            <a class="mini-cert-card" href="https://learn.microsoft.com/api/credentials/share/pt-pt/RodrigoNarciso-1078/B5641CD9AD188602?sharingId" target="_blank">
                <div class="cert-provider microsoft">
                    <i class="bi bi-microsoft"></i>
                </div>
                <h4>Microsoft Applied Skills</h4>
                <p>GitHub Copilot para Desenvolvimento</p>
            </a>

            <a class="mini-cert-card" href="https://www.udemy.com/certificate/UC-e918eea4-1070-468c-b5a0-e0f6722f9eae/" target="_blank">
                <div class="cert-provider udemy">
                    <img src="/Images/Udemy_Symbol_1.png" alt="Udemy" class="udemy-icon-mini" />
                </div>
                <h4>Event-Driven Architecture</h4>
                <p>The Complete Guide</p>
            </a>

            <a class="mini-cert-card" href="https://www.udemy.com/certificate/UC-4f8406aa-4c29-4eb5-9d25-463835bf1261/" target="_blank">
                <div class="cert-provider udemy">
                    <img src="/Images/Udemy_Symbol_1.png" alt="Udemy" class="udemy-icon-mini" />
                </div>
                <h4>Software Architecture & Design</h4>
                <p>Modern Large Scale Systems</p>
            </a>

            <a class="mini-cert-card" href="https://www.udemy.com/certificate/UC-493f6d59-79e3-41aa-8e21-9eb5fa55f95d/" target="_blank">
                <div class="cert-provider udemy">
                    <img src="/Images/Udemy_Symbol_1.png" alt="Udemy" class="udemy-icon-mini" />
                </div>
                <h4>Entity Framework in Depth</h4>
                <p>The Complete Guide</p>
            </a>
        </div>

        <div class="cta-button-container">
            <NavLink href="certificacoes" class="cta-button">
                <span>Ver Todas as Certificações (13+)</span>
                <i class="bi bi-arrow-right"></i>
            </NavLink>
        </div>
    </section>    
</div>

<style>
    /* ========================================
       HERO SECTION
       ======================================== */
    .hero-section {
        text-align: center;
        padding: 2rem 0 4rem;
        animation: fadeInUp 0.6s ease-out;
    }

    .hero-profile-section {
        display: flex;
        justify-content: center;
        margin-bottom: 2.5rem;
    }

    .hero-image-wrapper {
        position: relative;
        width: 200px;
        height: 200px;
        animation: fadeInScale 0.8s ease-out;
    }

    .hero-profile-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 6px solid rgba(99, 102, 241, 0.3);
        box-shadow: 
            0 15px 50px rgba(99, 102, 241, 0.5),
            0 0 0 1px rgba(255, 255, 255, 0.1);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        z-index: 3;
    }

    .hero-image-wrapper:hover .hero-profile-image {
        transform: scale(1.05);
        box-shadow: 
            0 20px 70px rgba(99, 102, 241, 0.7),
            0 0 0 1px rgba(255, 255, 255, 0.2);
        border-color: rgba(99, 102, 241, 0.6);
    }

    .hero-profile-ring {
        position: absolute;
        top: -12px;
        left: -12px;
        right: -12px;
        bottom: -12px;
        border-radius: 50%;
        background: conic-gradient(
            from 0deg,
            #4F46E5,
            #7C3AED,
            #EC4899,
            #F59E0B,
            #4F46E5
        );
        z-index: 2;
        animation: rotateRing 6s linear infinite;
        opacity: 0.7;
    }

    .hero-profile-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(99, 102, 241, 0.3) 0%,
            rgba(124, 58, 237, 0.2) 30%,
            transparent 70%
        );
        z-index: 1;
        animation: pulse 3s ease-in-out infinite;
    }

    @@keyframes rotateRing {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    @@keyframes pulse {
        0%, 100% { 
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.5;
        }
        50% { 
            transform: translate(-50%, -50%) scale(1.1);
            opacity: 0.7;
        }
    }

    @@keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.8);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .hero-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 800;
        background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #EC4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
    }

    .hero-subtitle {
        font-size: clamp(1.25rem, 2.5vw, 1.75rem);
        color: var(--text-secondary);
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .hero-description {
        font-size: 1.125rem;
        color: var(--text-muted);
        max-width: 700px;
        margin: 0 auto;
        line-height: 1.8;
    }

    /* ========================================
       STATS SECTION
       ======================================== */
    .stats-section {
        padding: 3rem 0;
        animation: fadeInUp 0.6s ease-out 0.6s backwards;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        max-width: 1000px;
        margin: 0 auto;
    }

    .stat-item {
        text-align: center;
        padding: 2rem 1.5rem;
        background: rgba(11, 14, 20, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .stat-item:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 60px rgba(99, 102, 241, 0.3);
        border-color: rgba(99, 102, 241, 0.6);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #4F46E5, #7C3AED);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.3);
    }

    .stat-icon i {
        font-size: 1.75rem;
        color: white;
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #4F46E5, #EC4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        color: var(--text-secondary);
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0;
    }

    /* ========================================
       SKILLS PREVIEW
       ======================================== */
    .skills-preview-section {
        padding: 4rem 0;
        animation: fadeInUp 0.6s ease-out 0.8s backwards;
    }

    .section-description {
        text-align: center;
        color: var(--text-muted);
        font-size: 1.125rem;
        max-width: 700px;
        margin: -1rem auto 3rem;
    }

    .skills-showcase {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .skill-group {
        background: rgba(11, 14, 20, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 20px;
        padding: 2.5rem 2rem;
        transition: all 0.4s ease;
    }

    .skill-group:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 60px rgba(99, 102, 241, 0.3);
        border-color: rgba(99, 102, 241, 0.6);
    }

    .skill-group-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .skill-group-header i {
        font-size: 2rem;
        color: #8B5CF6;
    }

    .skill-group-header h3 {
        font-size: 1.375rem;
        font-weight: 700;
        margin: 0;
    }

    .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .skill-badge {
        padding: 0.6rem 1.25rem;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        border: 1px solid;
        transition: all 0.3s ease;
    }

    .skill-badge.primary {
        background: rgba(79, 70, 229, 0.15);
        color: #818CF8;
        border-color: rgba(79, 70, 229, 0.3);
    }

    .skill-badge.secondary {
        background: rgba(124, 58, 237, 0.15);
        color: #A78BFA;
        border-color: rgba(124, 58, 237, 0.3);
    }

    .skill-badge.tertiary {
        background: rgba(236, 72, 153, 0.15);
        color: #F472B6;
        border-color: rgba(236, 72, 153, 0.3);
    }

    .skill-badge.accent {
        background: rgba(16, 185, 129, 0.15);
        color: #34D399;
        border-color: rgba(16, 185, 129, 0.3);
    }

    .skill-badge:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    /* ========================================
       FEATURED PROJECT
       ======================================== */
    .featured-project-section {
        padding: 4rem 0;
        animation: fadeInUp 0.6s ease-out 1s backwards;
    }

    .featured-project-card {
        background: rgba(11, 14, 20, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(99, 102, 241, 0.3);
        border-radius: 24px;
        padding: 3rem;
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease;
    }

    .featured-project-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #4F46E5, #7C3AED, #EC4899);
    }

    .featured-project-card:hover {
        box-shadow: 0 25px 70px rgba(99, 102, 241, 0.4);
        border-color: rgba(99, 102, 241, 0.6);
    }

    .project-badge-featured {
        position: absolute;
        top: 2rem;
        right: 2rem;
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
        padding: 0.6rem 1.25rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }

    .project-header-featured {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .project-icon-large {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #4F46E5, #7C3AED);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
        flex-shrink: 0;
    }

    .project-icon-large i {
        font-size: 2.5rem;
        color: white;
    }

    .project-title-large {
        font-size: 2rem;
        font-weight: 800;
        margin: 0 0 0.25rem 0;
    }

    .project-subtitle {
        color: var(--text-muted);
        font-size: 1.125rem;
        margin: 0;
    }

    .project-description-featured {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 2rem;
    }

    .project-highlights {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .highlight-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-secondary);
        font-weight: 600;
    }

    .highlight-item i {
        color: #10B981;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .project-tech-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
    }

    .tech-tag {
        background: rgba(99, 102, 241, 0.15);
        color: #8B5CF6;
        padding: 0.6rem 1.25rem;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .project-actions {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
    }

    .project-button {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 2rem;
        border-radius: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 1rem;
    }

    .project-button.primary {
        background: linear-gradient(135deg, #4F46E5, #7C3AED);
        color: white;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.3);
    }

    .project-button.primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 35px rgba(99, 102, 241, 0.5);
        color: white;
    }

    .project-button.secondary {
        background: transparent;
        color: var(--text-secondary);
        border: 2px solid rgba(99, 102, 241, 0.3);
    }

    .project-button.secondary:hover {
        border-color: rgba(99, 102, 241, 0.6);
        background: rgba(99, 102, 241, 0.1);
        transform: translateY(-3px);
        color: white;
    }

    /* ========================================
       RECENT CERTIFICATIONS
       ======================================== */
    .recent-certs-section {
        padding: 4rem 0;
        animation: fadeInUp 0.6s ease-out 1.2s backwards;
    }

    .recent-certs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .mini-cert-card {
        background: rgba(11, 14, 20, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 16px;
        padding: 2rem 1.75rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .mini-cert-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 60px rgba(99, 102, 241, 0.3);
        border-color: rgba(99, 102, 241, 0.6);
    }

    .cert-provider {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .cert-provider.microsoft {
        background: linear-gradient(135deg, #00A4EF, #0078D4);
    }

    .cert-provider.udemy {
        background: linear-gradient(135deg, #A435F0, #8710D8);
    }

    .cert-provider i {
        font-size: 1.5rem;
        color: white;
    }

    .udemy-icon-mini {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    .mini-cert-card h4 {
        font-size: 1.125rem;
        font-weight: 700;
        margin: 0;
        color: white;
    }

    .mini-cert-card p {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin: 0;
    }

    .mini-cert-card:hover h4 {
