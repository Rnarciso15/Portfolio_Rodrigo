@page "/formacao"

<div class="page-container">
    <div class="page-header">
        <h2 class="page-title">
            <span class="bi bi-mortarboard-fill" aria-hidden="true"></span>
            Educação e Formação
        </h2>
        <p class="page-subtitle">Percurso académico e desenvolvimento contínuo de competências</p>
    </div>

    <div class="education-timeline">
        <div class="timeline-item">
            <div class="timeline-marker current">
                <i class="bi bi-book-fill"></i>
            </div>
            <div class="timeline-content">
                <div class="timeline-badge current">Em Curso</div>
                <h4 class="timeline-title">Licenciatura em Gestão de Sistemas e Computação</h4>
                <p class="timeline-institution">
                    <i class="bi bi-building"></i>
                    Instituto Universitário Atlântica
                </p>
                <p class="timeline-description">
                    Formação focada em arquitetura de sistemas, desenvolvimento de software,
                    gestão de projetos e tecnologias emergentes. Desenvolvimento de competências
                    em .NET, bases de dados, cloud computing e boas práticas de engenharia de software.
                </p>
                <div class="timeline-skills">
                    <span class="skill-tag">C</span>
                    <span class="skill-tag">Java</span>
                    <span class="skill-tag">MySQL</span>
                    <span class="skill-tag">Redes</span>
                    <span class="skill-tag">Packet Tracer</span>
                    <span class="skill-tag">Arquitetura de Sistemas</span>
                    <span class="skill-tag">Gestão de Projetos</span>
                    <span class="skill-tag">Economia</span>
                    <span class="skill-tag">Estatística</span>
                    <span class="skill-tag">Gestão Logística</span>
                    <span class="skill-tag">GitHub</span>
                    <span class="skill-tag">Microsoft Office</span>
                </div>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker completed">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="timeline-content">
                <div class="timeline-badge completed">Concluído</div>
                <h4 class="timeline-title">12.º Ano — Gestão e Programação de Sistemas Informáticos</h4>
                <p class="timeline-institution">
                    <i class="bi bi-building"></i>
                    Escola Profissional Gustave Eiffel
                </p>
                <p class="timeline-description">
                    Formação técnica profissional com foco em programação, gestão de sistemas
                    informáticos e redes. Base sólida em lógica de programação, desenvolvimento
                    de aplicações e administração de sistemas.
                </p>
                <div class="timeline-skills">
                    <span class="skill-tag">VB.NET</span>
                    <span class="skill-tag">C#</span>
                    <span class="skill-tag">Java</span>
                    <span class="skill-tag">Bases de Dados</span>
                    <span class="skill-tag">SQL Server</span>
                    <span class="skill-tag">MySQL</span>
                    <span class="skill-tag">Desenvolvimento Web</span>
                    <span class="skill-tag">Windows Server</span>
                    <span class="skill-tag">GitHub</span>
                    <span class="skill-tag">Redes</span>
                    <span class="skill-tag">Arquitetura de Computadores</span>
                    <span class="skill-tag">Microsoft Office</span>
                </div>
            </div>
        </div>
    </div>

    <div class="stats-section">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <div class="stat-content">
                <h3 class="stat-number">14+</h3>
                <p class="stat-label">Certificações Obtidas</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-code-slash"></i>
            </div>
            <div class="stat-content">
                <h3 class="stat-number">100+</h3>
                <p class="stat-label">Horas de Formação</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="stat-content">
                <h3 class="stat-number">Contínuo</h3>
                <p class="stat-label">Desenvolvimento</p>
            </div>
        </div>
    </div>
</div>

<style>
    .page-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        animation: fadeInUp 0.6s ease-out;
    }

    .page-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .page-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #EC4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .title-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #4F46E5, #7C3AED, #EC4899);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
    }

    .title-icon i {
        font-size: 1.75rem;
        color: white;
    }

    .page-subtitle {
        font-size: 1.25rem;
        color: var(--text-secondary);
        max-width: 700px;
        margin: 0 auto;
    }

    /* Timeline */
    .education-timeline {
        position: relative;
        padding-left: 3rem;
        margin-bottom: 4rem;
    }

    .education-timeline::before {
        content: '';
        position: absolute;
        left: 28px;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(180deg, #4F46E5, #7C3AED, #EC4899);
        border-radius: 3px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 3.5rem;
        animation: slideInLeft 0.6s ease-out backwards;
    }

    .timeline-item:nth-child(2) {
        animation-delay: 0.2s;
    }

    .timeline-marker {
        position: absolute;
        left: -3rem;
        top: 0;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 4px rgba(10, 14, 39, 1);
        z-index: 2;
    }

    .timeline-marker.current {
        background: linear-gradient(135deg, #10B981, #059669);
        animation: pulse 2s ease-in-out infinite;
    }

    .timeline-marker.completed {
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
    }

    .timeline-marker i {
        font-size: 1.5rem;
        color: white;
    }

    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 4px rgba(10, 14, 39, 1), 0 0 0 8px rgba(16, 185, 129, 0.4);
        }
        50% {
            box-shadow: 0 0 0 4px rgba(10, 14, 39, 1), 0 0 0 16px rgba(16, 185, 129, 0);
        }
    }

    .timeline-content {
        background: rgba(21, 25, 50, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 20px;
        padding: 2.5rem;
        position: relative;
        transition: all 0.4s ease;
    }

    .timeline-content::before {
        content: '';
        position: absolute;
        left: -12px;
        top: 20px;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 10px 12px 10px 0;
        border-color: transparent rgba(99, 102, 241, 0.2) transparent transparent;
    }

    .timeline-content:hover {
        transform: translateX(10px);
        box-shadow: 0 20px 60px rgba(99, 102, 241, 0.3);
        border-color: rgba(99, 102, 241, 0.6);
        background: rgba(30, 35, 70, 0.95);
    }

    .timeline-badge {
        position: absolute;
        top: 2rem;
        right: 2rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .timeline-badge.current {
        background: rgba(16, 185, 129, 0.2);
        color: #10B981;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .timeline-badge.completed {
        background: rgba(99, 102, 241, 0.2);
        color: #8B5CF6;
        border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .timeline-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        margin-bottom: 1rem;
        padding-right: 8rem;
    }

    .timeline-institution {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-secondary);
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
    }

    .timeline-institution i {
        font-size: 1.25rem;
        color: #8B5CF6;
    }

    .timeline-description {
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 1.5rem;
    }

    .timeline-skills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .skill-tag {
        background: rgba(99, 102, 241, 0.15);
        color: #8B5CF6;
        padding: 0.5rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid rgba(99, 102, 241, 0.3);
        transition: all 0.3s ease;
    }

    .skill-tag:hover {
        background: rgba(99, 102, 241, 0.25);
        transform: translateY(-2px);
    }

    /* Stats Section */
    .stats-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 4rem;
    }

    .stat-card {
        background: rgba(21, 25, 50, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 20px;
        padding: 2.5rem 2rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        transition: all 0.4s ease;
        animation: fadeInUp 0.6s ease-out backwards;
    }

    .stat-card:nth-child(1) { animation-delay: 0.3s; }
    .stat-card:nth-child(2) { animation-delay: 0.4s; }
    .stat-card:nth-child(3) { animation-delay: 0.5s; }

    .stat-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 60px rgba(99, 102, 241, 0.3);
        border-color: rgba(99, 102, 241, 0.6);
        background: rgba(30, 35, 70, 0.95);
    }

    .stat-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #4F46E5, #7C3AED);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.3);
        flex-shrink: 0;
    }

    .stat-icon i {
        font-size: 2rem;
        color: white;
    }

    .stat-content {
        flex-grow: 1;
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #4F46E5, #EC4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        color: var(--text-secondary);
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@media (max-width: 768px) {
        .page-title {
            flex-direction: column;
        }

        .education-timeline {
            padding-left: 2.5rem;
        }

        .education-timeline::before {
            left: 23px;
        }

        .timeline-marker {
            left: -2.5rem;
            width: 50px;
            height: 50px;
        }

        .timeline-marker i {
            font-size: 1.25rem;
        }

        .timeline-content {
            padding: 2rem 1.5rem;
        }

        .timeline-title {
            padding-right: 0;
            font-size: 1.25rem;
        }

        .timeline-badge {
            position: relative;
            top: auto;
            right: auto;
            display: inline-block;
            margin-bottom: 1rem;
        }

        .stats-section {
            grid-template-columns: 1fr;
        }

        .stat-card {
            padding: 2rem 1.5rem;
        }
    }
</style>